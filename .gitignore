# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
**/dist/
*.tsbuildinfo

# Local environment
.env
.env.*
!.env.example

# Tool caches
.vite/
**/.vite/
**/supabase/.temp/

# OS/editor noise
.DS_Store
Thumbs.db

# Never commit credentials pasted into the working tree
supabase access token
*access token*
*.token

# Client-supplied specs and log printouts. These land in the repo root by
# habit and some carry live credentials, so keep them out of git history.
*.pdf
*.docx
*.xls
*.xlsx

# Client documents land in the repo root, sometimes with no file extension.
VIWP*
*Daily Log Print*
Product names to confirm*
Warehouse Wizard - Status*
What I need from you*

# Written by a one-off `deno check`, not part of the build.
deno.lock

# Client worksheets exported for review. The earlier sweep covered PDF, Word and
# Excel but not CSV, which is how a product list stayed tracked in a public repo.
*.csv
!**/src/**/*.csv
